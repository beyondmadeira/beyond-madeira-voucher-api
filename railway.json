{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "startCommand": "sh -c 'gunicorn main:app --workers 2 --threads 8 --worker-class gthread --bind 0.0.0.0:${PORT:-8080} --timeout 120 --graceful-timeout 30 --access-logfile - --error-logfile -'"
  }
}
