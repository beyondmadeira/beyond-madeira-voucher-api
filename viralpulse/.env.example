# ViralPulse — variáveis de ambiente
# Copia para .env e preenche. O .env NUNCA vai para o git (ver .gitignore).

# ─── Modo de operação ───────────────────────────────────────────────
# DRY_RUN=true  → não chama APIs externas nem publica; usa dados de exemplo.
#                 Ideal para desenvolver e ver o sistema todo a correr sem credenciais.
VIRALPULSE_DRY_RUN=true

# Requer aprovação humana antes de qualquer publicação (recomendado: true)
VIRALPULSE_REQUIRE_APPROVAL=true

# ─── Instagram Graph API (descoberta + publicação) ──────────────────
# Conta de negócio/criador ligada a uma App do Facebook.
# Docs: https://developers.facebook.com/docs/instagram-api
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# ─── TikTok (Research API p/ descoberta, Content Posting p/ publicação) ─
# Requer aprovação da TikTok for Developers.
# Docs: https://developers.tiktok.com/doc/content-posting-api-get-started
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─── Dashboard ──────────────────────────────────────────────────────
# Password simples para o dashboard (à semelhança do MADEIRADAILY_PASSWORD).
VIRALPULSE_DASHBOARD_PASSWORD=muda-me

# ─── Base de dados ──────────────────────────────────────────────────
VIRALPULSE_DATABASE_URL=sqlite:///viralpulse.db
